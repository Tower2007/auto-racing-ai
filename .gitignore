# Data / logs
# data/ 以下は基本 ignore だが Streamlit Cloud デプロイ用にモデル/小型 CSV のみ例外
data/*
!data/production_model.lgb
!data/production_calib.pkl
!data/production_meta.json
!data/expected_votes.csv
!data/bet_history.csv
!data/bet_history_detail.csv
# click-to-buy のトークンログ・購入記録は data/ 配下だが機密扱いで commit しない
data/buy_tokens.csv
data/purchase_log.csv
*.db
*.sqlite
*.sqlite3
# logs/ は基本 ignore。ただし夜次の反省ログは正本 (夜次メール契約 v1 §3) のため
# commit 対象 (dir ごと除外すると再包含できない git 仕様のため logs/* 形式にする)
logs/*
!logs/reflections/
logs/reflections/*
!logs/reflections/*.md
*.log

# Codex / 各 AI の作業中 temp ディレクトリ
Opinion/tmp_*/
Opinion/.venv/

